# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_foundry
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_foundry
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Analytics ---
# Salt for the daily-rotating visitor hash (any random string).
ANALYTICS_SALT=

# --- Email (Resend) ---
# Get a key at https://resend.com — leave empty to disable sending (logs instead).
RESEND_API_KEY=
EMAIL_FROM="App Foundry <noreply@example.com>"

# --- Frontends ---
# Base URL the browser uses to reach the API (baked in at build time by Vite).
VITE_API_URL=http://localhost:8000
