# GENERATED by infralift: state backend = OpenTofu + R2, encrypted.
#
# State holds every credential this stack mints (deploy key, Access service
# token, R2 and DNS tokens), so it is encrypted client-side before it reaches
# the bucket. The passphrase is TF_VAR_state_passphrase; lose it and the
# state is unreadable.
#
# Bucket, key and endpoint come from backend.r2.hcl (see the .example), so
# the account id stays out of this file:
#   tofu init -backend-config=backend.r2.hcl
#
# To use Terraform Cloud instead, replace this file with backends/tfc.tf.

variable "state_passphrase" {
  type      = string
  sensitive = true
}

terraform {
  backend "s3" {
    region                      = "auto"
    use_path_style              = true
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_lockfile                = true
  }

  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = var.state_passphrase
    }

    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }

    state {
      method   = method.aes_gcm.state
      enforced = true
    }

    plan {
      method   = method.aes_gcm.state
      enforced = true
    }
  }
}
