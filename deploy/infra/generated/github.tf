# GENERATED by infralift.
#
# Everything the workflows need is written straight into the repository's
# Actions settings, so no credential is ever copied by hand. These values are
# in state, which is why the R2 backend encrypts it.

locals {
  actions_secrets = {
    DEPLOY_SSH_KEY          = tls_private_key.deploy.private_key_openssh
    CF_ACCESS_CLIENT_ID     = cloudflare_zero_trust_access_service_token.deploy.client_id
    CF_ACCESS_CLIENT_SECRET = cloudflare_zero_trust_access_service_token.deploy.client_secret
    CF_PREVIEW_DNS_TOKEN    = cloudflare_account_token.preview_dns.value
    R2_ACCESS_KEY_ID        = cloudflare_account_token.backups.id
    R2_SECRET_ACCESS_KEY    = sha256(cloudflare_account_token.backups.value)
  }

  actions_variables = {
    PROD_HOST       = local.prod_host
    SSH_HOST        = local.ssh_host
    SSH_KNOWN_HOSTS = "${local.ssh_host} ${trimspace(tls_private_key.host.public_key_openssh)}"
    PREVIEW_PREFIX  = local.preview_prefix
    MAX_PREVIEWS    = tostring(var.max_previews)
    ZONE_NAME       = var.zone_name
    ZONE_ID         = data.cloudflare_zone.this.zone_id
    TUNNEL_ID       = cloudflare_zero_trust_tunnel_cloudflared.box.id
    R2_BUCKET       = cloudflare_r2_bucket.backups.name
    R2_ENDPOINT     = "https://${var.cloudflare_account_id}.r2.cloudflarestorage.com"
  }
}

resource "github_actions_secret" "this" {
  for_each = toset(nonsensitive(keys(local.actions_secrets)))

  repository  = var.github_repository
  secret_name = each.key
  value       = local.actions_secrets[each.key]
}

resource "github_actions_variable" "this" {
  for_each = local.actions_variables

  repository    = var.github_repository
  variable_name = each.key
  value         = each.value
}
