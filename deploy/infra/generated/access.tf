# GENERATED by infralift.

# What GitHub Actions presents to Access to open the SSH hostname.
resource "cloudflare_zero_trust_access_service_token" "deploy" {
  account_id = var.cloudflare_account_id
  name       = "${var.name}-deploy"
  duration   = "8760h"
}

resource "cloudflare_zero_trust_access_policy" "admins" {
  account_id = var.cloudflare_account_id
  name       = "${var.name}-admins"
  decision   = "allow"
  include    = [for e in var.admin_emails : { email = { email = e } }]
}

resource "cloudflare_zero_trust_access_policy" "deploy" {
  account_id = var.cloudflare_account_id
  name       = "${var.name}-deploy"
  decision   = "non_identity"
  include = [{
    service_token = { token_id = cloudflare_zero_trust_access_service_token.deploy.id }
  }]
}

# SSH: the deploy token for CI, admins (browser login) for a human with
# `cloudflared access ssh`.
resource "cloudflare_zero_trust_access_application" "ssh" {
  account_id       = var.cloudflare_account_id
  name             = "${var.name} ssh"
  type             = "self_hosted"
  domain           = local.ssh_host
  session_duration = "24h"

  policies = [
    { id = cloudflare_zero_trust_access_policy.deploy.id, precedence = 1 },
    { id = cloudflare_zero_trust_access_policy.admins.id, precedence = 2 },
  ]
}

# The admin app and the analytics read API have no auth of their own.
# Previews do not get this; Caddy refuses those paths on preview hosts.
resource "cloudflare_zero_trust_access_application" "admin" {
  account_id       = var.cloudflare_account_id
  name             = "${var.name} admin"
  type             = "self_hosted"
  session_duration = "24h"

  destinations = [
    { type = "public", uri = "${local.prod_host}/admin" },
    { type = "public", uri = "${local.prod_host}/api/analytics" },
  ]

  policies = [
    { id = cloudflare_zero_trust_access_policy.admins.id, precedence = 1 },
  ]
}

# The zone may already have an Access app on *.<zone> (infralift.dev does),
# which would put a login in front of the app. Access applies the most
# specific match, so this opens production and previews to the public while
# the admin app above still guards /admin and /api/analytics on production.
resource "cloudflare_zero_trust_access_policy" "public" {
  account_id = var.cloudflare_account_id
  name       = "${var.name}-public"
  decision   = "bypass"
  include    = [{ everyone = {} }]
}

resource "cloudflare_zero_trust_access_application" "public" {
  account_id = var.cloudflare_account_id
  name       = "${var.name} public"
  type       = "self_hosted"

  destinations = [
    { type = "public", uri = local.prod_host },
    { type = "public", uri = "${local.preview_prefix}*.${var.zone_name}" },
  ]

  policies = [
    { id = cloudflare_zero_trust_access_policy.public.id, precedence = 1 },
  ]
}
