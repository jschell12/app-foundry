#cloud-config
# GENERATED by infralift. Runs once, on first boot.
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - unattended-upgrades
  - curl
  - rsync

users:
  - name: deploy
    groups: [docker]
    shell: /bin/bash
    ssh_authorized_keys:
      - ${deploy_public_key}

ssh_deletekeys: true
ssh_keys:
  ed25519_private: |
    ${indent(4, host_private_key)}
  ed25519_public: ${host_public_key}

write_files:
  # sshd only needs to answer cloudflared on localhost. The firewall already
  # drops inbound traffic; this keeps that true if the firewall is detached.
  - path: /etc/ssh/sshd_config.d/10-tunnel-only.conf
    content: |
      ListenAddress 127.0.0.1
      PasswordAuthentication no
      PermitRootLogin no

runcmd:
  - mkdir -p /srv/app-foundry/data
  - echo '${volume_device} /srv/app-foundry/data ext4 defaults,nofail,discard 0 2' >> /etc/fstab
  - for i in $(seq 60); do [ -e '${volume_device}' ] && break; sleep 5; done
  - mount /srv/app-foundry/data
  - chown -R deploy:deploy /srv/app-foundry
  # Ubuntu 24.04 socket-activates sshd; the generator rereads ListenAddress.
  - systemctl daemon-reload
  - systemctl restart ssh.socket ssh.service
  - curl -fsSL -o /tmp/cloudflared.deb '${cloudflared_url}'
  - echo '${cloudflared_sha}  /tmp/cloudflared.deb' | sha256sum -c -
  - dpkg -i /tmp/cloudflared.deb
  - cloudflared service install ${tunnel_token}
