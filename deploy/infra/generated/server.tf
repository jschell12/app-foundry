# GENERATED by infralift.

# Key GitHub Actions uses to reach the box, through the tunnel.
resource "tls_private_key" "deploy" {
  algorithm = "ED25519"
}

# The box's own host key, generated here so the workflows can pin it in
# known_hosts instead of trusting whatever answers on first connect.
resource "tls_private_key" "host" {
  algorithm = "ED25519"
}

resource "hcloud_ssh_key" "deploy" {
  name       = "${var.name}-deploy"
  public_key = tls_private_key.deploy.public_key_openssh
  labels     = local.labels
}

# No rules on purpose. A Hetzner firewall drops all inbound traffic that no
# rule allows, and nothing needs to be allowed: the box dials out to
# Cloudflare and both HTTP and SSH arrive through that tunnel.
resource "hcloud_firewall" "box" {
  name   = var.name
  labels = local.labels
}

resource "hcloud_volume" "data" {
  name              = "${var.name}-data"
  size              = var.data_volume_gb
  location          = var.location
  format            = "ext4"
  delete_protection = true
  labels            = local.labels
}

resource "hcloud_server" "box" {
  name         = var.name
  server_type  = var.server_type
  image        = var.image
  location     = var.location
  ssh_keys     = [hcloud_ssh_key.deploy.id]
  firewall_ids = [hcloud_firewall.box.id]
  labels       = local.labels

  # GHCR and Docker Hub are still IPv4-only for pulls.
  public_net {
    ipv4_enabled = true
    ipv6_enabled = true
  }

  user_data = templatefile("${path.module}/cloud-init.yaml.tftpl", {
    deploy_public_key = trimspace(tls_private_key.deploy.public_key_openssh)
    host_private_key  = tls_private_key.host.private_key_openssh
    host_public_key   = trimspace(tls_private_key.host.public_key_openssh)
    volume_device     = hcloud_volume.data.linux_device
    tunnel_token      = data.cloudflare_zero_trust_tunnel_cloudflared_token.box.token
  })

  # cloud-init only runs on first boot, so a changed template would mean a
  # rebuilt server. Rebuild deliberately with `tofu apply -replace`.
  lifecycle {
    ignore_changes = [user_data, image]
  }
}

# Attached separately so the server's cloud-init can name the volume's
# device without a dependency cycle. cloud-init waits for it to appear.
resource "hcloud_volume_attachment" "data" {
  volume_id = hcloud_volume.data.id
  server_id = hcloud_server.box.id
  automount = false
}
