# GENERATED by infralift.

data "cloudflare_zone" "this" {
  filter = {
    name = var.zone_name
  }
}

resource "cloudflare_zero_trust_tunnel_cloudflared" "box" {
  account_id = var.cloudflare_account_id
  name       = var.name
  config_src = "cloudflare"
}

data "cloudflare_zero_trust_tunnel_cloudflared_token" "box" {
  account_id = var.cloudflare_account_id
  tunnel_id  = cloudflare_zero_trust_tunnel_cloudflared.box.id
}

resource "cloudflare_zero_trust_tunnel_cloudflared_config" "box" {
  account_id = var.cloudflare_account_id
  tunnel_id  = cloudflare_zero_trust_tunnel_cloudflared.box.id

  config = {
    ingress = [
      {
        hostname = local.ssh_host
        service  = "ssh://localhost:22"
      },
      # Every other name routed to this tunnel (production and each preview)
      # goes to Caddy, which picks the environment by Host header and
      # answers 404 for names it does not know.
      {
        service = "http://localhost:80"
      },
    ]
  }
}

resource "cloudflare_dns_record" "prod" {
  zone_id = data.cloudflare_zone.this.zone_id
  name    = local.prod_host
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.box.id}.cfargotunnel.com"
  proxied = true
  ttl     = 1
  comment = "${var.name}: production (infralift)"
}

resource "cloudflare_dns_record" "ssh" {
  zone_id = data.cloudflare_zone.this.zone_id
  name    = local.ssh_host
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.box.id}.cfargotunnel.com"
  proxied = true
  ttl     = 1
  comment = "${var.name}: SSH through Access (infralift)"
}

resource "cloudflare_dns_record" "preview" {
  for_each = toset(local.preview_hosts)

  zone_id = data.cloudflare_zone.this.zone_id
  name    = each.value
  type    = "CNAME"
  content = "${cloudflare_zero_trust_tunnel_cloudflared.box.id}.cfargotunnel.com"
  proxied = true
  ttl     = 1
  comment = "${var.name}: preview slot (infralift)"
}
