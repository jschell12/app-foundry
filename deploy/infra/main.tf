# GENERATED by infralift. Everything in deploy/infra except overrides.tf
# and terraform.tfvars is rewritten when the project changes in the UI.

terraform {
  required_version = ">= 1.6"

  required_providers {
    hcloud = {
      source = "hetznercloud/hcloud"
    }
    cloudflare = {
      source = "cloudflare/cloudflare"
    }
    github = {
      source = "integrations/github"
    }
  }
}

# Credentials come from the environment, never from files:
#   HCLOUD_TOKEN, CLOUDFLARE_API_TOKEN, GITHUB_TOKEN (+ GITHUB_OWNER)
provider "hcloud" {}
provider "cloudflare" {}
provider "github" {}

locals {
  # What the UI chose. overrides.tf wins on any key it sets.
  ui_settings = {
    name                  = "app-foundry-demo"
    zone_name             = "infralift.dev"
    subdomain             = "demo"
    github_repository     = "app-foundry"
    location              = "nbg1"
    server_type           = "cx23"
    data_volume_gb        = 10
    backup_retention_days = 30
    max_previews          = 3
  }

  settings = merge(local.ui_settings, local.overrides)
}

module "app" {
  source = "./generated"

  cloudflare_account_id = var.cloudflare_account_id
  admin_emails          = var.admin_emails

  r2_backup_access_key_id     = var.r2_backup_access_key_id
  r2_backup_secret_access_key = var.r2_backup_secret_access_key

  name                  = local.settings.name
  zone_name             = local.settings.zone_name
  subdomain             = local.settings.subdomain
  github_repository     = local.settings.github_repository
  location              = local.settings.location
  server_type           = local.settings.server_type
  data_volume_gb        = local.settings.data_volume_gb
  backup_retention_days = local.settings.backup_retention_days
  max_previews          = local.settings.max_previews
  labels                = local.extra_labels
}
